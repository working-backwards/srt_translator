[MASTER]
ignore=venv,dist,build,.git

[MESSAGES CONTROL]
disable=
  C0114,C0115,C0116,   # docstrings (we'll add surgically)
  C0301,               # line length (we set 120)
  R0902,R0903,R0912,R0913,R0914,R0915,R1702,  # complexity in GUI/CLI/orchestrators
  R0801,               # duplicate-code (temporary)
  W0511                # TODO comments

[FORMAT]
max-line-length=120

[TYPECHECK]
ignored-modules=PySide6,PySide6.QtCore,PySide6.QtWidgets,PySide6.QtGui
# or: generated-members=PySide6.*

[BASIC]
good-names=i,j,k,_,db,fn,id,ok
