# =============================================================================
# SRT Translator Configuration
# =============================================================================

# Required: Your OpenAI API key
OPENAI_API_KEY=your_api_key_here

# =============================================================================
# Translation Settings
# =============================================================================

# Target languages to translate to (JSON format)
# Format: {"Language Name": "ISO_CODE"}
TARGET_LANGUAGES={"Spanish": "ES", "French": "FR", "German": "DE", "Japanese": "JA"}

# Terms that should NOT be translated (comma-separated)
# Examples: company names, person names, product names, technical terms
EXCLUDED_TERMS=Your Name,Your Company,YourProduct,CEO,CFO,Amazon,Jeff Bezos

# =============================================================================
# Directory Settings
# =============================================================================

# Directory containing original .srt files
INPUT_DIRECTORY=original_captions

# Directory where translated files will be saved
OUTPUT_DIRECTORY=translated_srt_files

# Directory for translation logs
LOGS_DIRECTORY=translation_logs

# =============================================================================
# Advanced Settings
# =============================================================================

# Source language code (default: EN)
SOURCE_LANG=EN

# OpenAI model to use for translations
OPENAI_MODEL=gpt-4o-mini

# Auto-fix aggressiveness for placeholder issues (0.0 to 1.0)
# 0.0 = No automatic fixes, manual intervention required
# 0.5 = Fix missing placeholders only
# 0.75 = Fix missing placeholders + simple reordering (recommended)
# 1.0 = Aggressive fixes including context mismatches
AGGRESSIVENESS=0.75

# =============================================================================
# Translation Prompt Customization (Optional)
# =============================================================================

# Customize the translation prompt used for all languages
# Available variables: {source_lang}, {target_lang}
# If not specified, a built-in default prompt will be used

# Optional: Specify custom prompt file path (default: translation_prompt.txt)
TRANSLATION_PROMPT_FILE=translation_prompt.txt

# Number of subtitles to send in each translation batch (default: 5)
BATCH_SIZE=5